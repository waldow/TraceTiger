<Window x:Class="TraceTiger.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TraceTiger"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource BgSurface}"
        Foreground="{DynamicResource TextPrimary}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderFocus}" BorderThickness="1">
        <StackPanel Margin="20,14,20,16">
            <TextBlock x:Name="TitleText" Text="Rename" FontSize="14" FontWeight="SemiBold"
                       Margin="0,0,0,10"/>
            <TextBlock x:Name="PromptText" Text="Name:" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
            <TextBox x:Name="NameBox" FontSize="13" Padding="8,6"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" Style="{StaticResource GhostButton}" Width="76"
                        Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
                <Button Content="OK" Style="{StaticResource PrimaryButton}" Width="76"
                        Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
