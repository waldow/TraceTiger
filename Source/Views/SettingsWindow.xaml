<Window x:Class="TraceTiger.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TraceTiger.ViewModels"
        mc:Ignorable="d"
        Title="TraceTiger Settings"
        Width="760" Height="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderFocus}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Border Grid.Row="0" Background="{DynamicResource BgSurface}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="16,10">
                <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold"/>
            </Border>

            <!-- connections -->
            <Grid Grid.Row="1" Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="CONNECTIONS" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Connections}"
                             SelectedItem="{Binding SelectedConnection}"
                             Background="{DynamicResource BgSurface}" BorderThickness="1"
                             BorderBrush="{DynamicResource BorderBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ConnectionEditViewModel}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center"
                                             Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="+ Add" Style="{StaticResource GhostButton}" FontSize="11"
                                Command="{Binding AddConnectionCommand}"/>
                        <Button Content="Duplicate" Style="{StaticResource GhostButton}" FontSize="11" Margin="4,0,0,0"
                                Command="{Binding DuplicateConnectionCommand}"/>
                        <Button Content="Remove" Style="{StaticResource GhostButton}" FontSize="11" Margin="4,0,0,0"
                                Command="{Binding RemoveConnectionCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- connection detail -->
                <Border Grid.Column="2" Background="{DynamicResource BgSurface}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Padding="14" CornerRadius="4">
                    <StackPanel DataContext="{Binding SelectedConnection}"
                                Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Name" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Badge" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                <ListBox SelectedItem="{Binding ColorHex}" BorderThickness="0" Background="Transparent"
                                         ItemsSource="{Binding DataContext.ColorChoices, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="16" Height="16" Margin="2"
                                                     Fill="{Binding Converter={StaticResource HexToBrush}}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Kind" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,12,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource ModeTogglePill}" Content="App Insights"
                                         IsChecked="{Binding Kind, Converter={StaticResource EnumMatchToBool}, ConverterParameter=AppInsightsResource}"/>
                            <RadioButton Style="{StaticResource ModeTogglePill}" Content="Log Analytics" Margin="4,0,0,0"
                                         IsChecked="{Binding Kind, Converter={StaticResource EnumMatchToBool}, ConverterParameter=LogAnalyticsWorkspace}"/>
                            <RadioButton Style="{StaticResource ModeTogglePill}" Content="Demo" Margin="4,0,0,0"
                                         IsChecked="{Binding Kind, Converter={StaticResource EnumMatchToBool}, ConverterParameter=Demo}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <TextBlock Text="ARM resource id" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,12,0,4"/>
                            <TextBox Text="{Binding ResourceId, UpdateSourceTrigger=PropertyChanged}" FontSize="11"
                                     FontFamily="{DynamicResource CodeFont}" TextWrapping="Wrap" AcceptsReturn="False"
                                     MinHeight="44" VerticalContentAlignment="Top"
                                     ToolTip="/subscriptions/&lt;sub&gt;/resourceGroups/&lt;rg&gt;/providers/microsoft.insights/components/&lt;name&gt;"/>

                            <StackPanel Visibility="{Binding IsWorkspace, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="…or workspace GUID" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,4"/>
                                <TextBox Text="{Binding WorkspaceId, UpdateSourceTrigger=PropertyChanged}" FontSize="11"
                                         FontFamily="{DynamicResource CodeFont}"
                                         ToolTip="The Log Analytics workspace id (GUID) — used instead of the ARM id when set"/>
                            </StackPanel>

                            <TextBlock Text="Tenant id (optional)" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,4"/>
                            <TextBox Text="{Binding TenantId, UpdateSourceTrigger=PropertyChanged}" FontSize="11"
                                     FontFamily="{DynamicResource CodeFont}"
                                     ToolTip="Pin sign-in to a specific Entra tenant (useful for guest accounts)"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Sign in &amp; test" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding TestCommand}"
                                    IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}"/>
                            <TextBlock Text="{Binding TestStatus}" FontSize="11" Margin="10,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="280">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentRed}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TestPassed}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- scripts folder + editor prefs -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Scripts folder" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ScriptsFolder, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="11" FontFamily="{DynamicResource CodeFont}"/>
                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource GhostButton}" FontSize="11"
                                    Margin="6,0,0,0" Command="{Binding BrowseScriptsFolderCommand}"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Editor font size" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditorFontSize, UpdateSourceTrigger=PropertyChanged}" Width="52" FontSize="12"/>
                        </StackPanel>
                        <CheckBox Content="Word wrap" IsChecked="{Binding EditorWordWrap}"
                                  VerticalAlignment="Bottom" Margin="0,0,14,6" FontSize="12"/>
                        <StackPanel>
                            <TextBlock Text="Default time range" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                            <ComboBox Width="140" FontSize="12"
                                      ItemsSource="{Binding TimeRangeOptions}"
                                      SelectedValuePath="Kind"
                                      SelectedValue="{Binding DefaultTimeRange}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- footer -->
            <Border Grid.Row="3" Background="{DynamicResource BgSurface}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Width="80"
                            Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Width="80"
                            Click="Save_Click" IsDefault="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
