<Window x:Class="TraceTiger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TraceTiger.ViewModels"
        xmlns:models="clr-namespace:TraceTiger.Models"
        xmlns:views="clr-namespace:TraceTiger.Views"
        xmlns:helpers="clr-namespace:TraceTiger.Helpers"
        mc:Ignorable="d"
        Title="TraceTiger"
        Height="800" Width="1280"
        MinHeight="520" MinWidth="860"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="T" Command="{Binding NewTabCommand}"/>
        <KeyBinding Modifiers="Control" Key="W" Command="{Binding CloseSelectedTabCommand}"/>
        <KeyBinding Modifiers="Control" Key="Tab" Command="{Binding NextTabCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="Tab" Command="{Binding PreviousTabCommand}"/>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SelectedTab.SaveCommand}"/>
        <KeyBinding Modifiers="Control" Key="Enter" Command="{Binding SelectedTab.RunOrCancelCommand}"/>
        <KeyBinding Key="F5" Command="{Binding SelectedTab.RunOrCancelCommand}"/>
    </Window.InputBindings>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                      CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowBorder"
            BorderBrush="{DynamicResource WindowBorderAccent}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ title bar ============ -->
            <Border Grid.Row="0" Background="{DynamicResource BgSurface}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <TextBlock Text="🐯" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Trace" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Text="Tiger" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentOrange}" VerticalAlignment="Center"/>
                        <TextBlock Text="v0.1" FontSize="11" Foreground="{DynamicResource TextMuted}"
                                   Margin="8,0,0,2" VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,8,0">
                        <Button Content="&#x2699; Settings" Style="{StaticResource GhostButton}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Command="{Binding OpenSettingsCommand}" ToolTip="Connections, scripts folder, editor"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="MinimizeButton" Style="{StaticResource WindowChromeButton}"
                                Click="MinimizeButton_Click" ToolTip="Minimize">
                            <Path Data="M 0 0 H 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Width="10" Height="1"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="MaximizeRestoreButton" Style="{StaticResource WindowChromeButton}"
                                Click="MaximizeRestoreButton_Click" ToolTip="Maximize">
                            <Path x:Name="MaximizeRestoreIcon" Data="M 0 0 H 10 V 10 H 0 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Width="10" Height="10" Stretch="Uniform"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource WindowChromeCloseButton}"
                                Click="CloseButton_Click" ToolTip="Close">
                            <Path Data="M 0 0 L 10 10 M 0 10 L 10 0"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Width="10" Height="10" Stretch="Uniform"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ body: library/history | splitter | tabs ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="200"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource BgSurface}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Border.Resources>
                        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>
                    </Border.Resources>
                    <TabControl SelectedIndex="{Binding LeftPanelTabIndex}" Background="Transparent">

                        <!-- ==== LIBRARY ==== -->
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="LIBRARY" FontSize="11" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </TabItem.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Padding="8,6"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="+ New Script" Style="{StaticResource GhostButton}"
                                                Command="{Binding NewScriptCommand}"
                                                HorizontalAlignment="Stretch" FontSize="11"/>
                                        <Button Grid.Column="1" Content="&#x21BB;" Style="{StaticResource GhostButton}"
                                                Command="{Binding RefreshLibraryCommand}" ToolTip="Refresh"
                                                FontSize="13" Padding="6,2" Margin="4,0,0,0"/>
                                        <Button Grid.Column="2" Content="&#x1F4C1;" Style="{StaticResource GhostButton}"
                                                Command="{Binding ChooseScriptsFolderCommand}" ToolTip="Choose scripts folder"
                                                FontSize="12" Padding="6,2" Margin="4,0,0,0"/>
                                    </Grid>
                                </Border>

                                <!-- empty state: no folder chosen yet -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="20"
                                            Visibility="{Binding HasScriptsFolder, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                    <TextBlock Text="No scripts folder yet" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="Pick a folder with .kql files (or an empty one to start fresh)."
                                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,6,0,12"/>
                                    <Button Content="Choose Folder…" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ChooseScriptsFolderCommand}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <TreeView Grid.Row="1" ItemsSource="{Binding LibraryItems}" Margin="4"
                                          Visibility="{Binding HasScriptsFolder, Converter={StaticResource BoolToVisibility}}">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type vm:ScriptTreeItemViewModel}"
                                                                  ItemsSource="{Binding Children}">
                                            <Grid Background="Transparent" ToolTipService.InitialShowDelay="600">
                                                <Grid.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                                  Command="{Binding Data.OpenScriptCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Grid.InputBindings>
                                                <Grid.ToolTip>
                                                    <ToolTip Visibility="{Binding Description, Converter={StaticResource NullToVisibility}}">
                                                        <TextBlock Text="{Binding Description}" MaxWidth="320" TextWrapping="Wrap"/>
                                                    </ToolTip>
                                                </Grid.ToolTip>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#x1F4C4;"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                        <Setter Property="Text" Value="&#x1F4C1;"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Title}" FontSize="12"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Open" FontWeight="SemiBold"
                                                                  Command="{Binding Data.OpenScriptCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="New script here"
                                                                  Command="{Binding Data.NewScriptCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="New folder here"
                                                                  Command="{Binding Data.NewFolderCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Rename"
                                                                  Command="{Binding Data.RenameScriptCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <MenuItem Header="Delete"
                                                                  Command="{Binding Data.DeleteScriptCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                        <Separator/>
                                                        <MenuItem Header="Reveal in Explorer"
                                                                  Command="{Binding Data.RevealInExplorerCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                            </Grid>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Grid>
                        </TabItem>

                        <!-- ==== HISTORY ==== -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="HISTORY" FontSize="11" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource BgPanel}" CornerRadius="8"
                                            Padding="6,2" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding HistoryEntries.Count}" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Runs will show up here."
                                           FontSize="11" Foreground="{DynamicResource TextMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HistoryEntries.Count, Converter={StaticResource ZeroToVisibility}}"/>

                                <ListBox Grid.Row="0" ItemsSource="{Binding HistoryEntries}"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:RunHistoryEntry}">
                                            <Grid Margin="0,2">
                                                <Grid.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                                  Command="{Binding Data.OpenHistoryEntryCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Grid.InputBindings>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="3" CornerRadius="1.5" Margin="0,2,8,2"
                                                        Background="{Binding ConnectionColorHex, Converter={StaticResource HexToBrush}}"/>
                                                <StackPanel Grid.Column="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding ScriptName}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding TimestampUtc, Converter={StaticResource RelativeTime}}"
                                                                   FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="6,0,0,0"/>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding ConnectionName}" FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondary}"/>
                                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="8,0,0,0"
                                                                   Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                                            <Run Text="{Binding RowCount, Mode=OneWay, StringFormat={}{0:N0} rows}"/>
                                                            <Run Text="·"/>
                                                            <Run Text="{Binding DurationMs, Mode=OneWay, StringFormat={}{0:F0} ms}"/>
                                                        </TextBlock>
                                                        <Border CornerRadius="3" Padding="4,1" Margin="8,0,0,0"
                                                                Background="{DynamicResource AccentRed}" Opacity="0.85"
                                                                Visibility="{Binding IsError, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="error" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Open in new tab" FontWeight="SemiBold"
                                                                  Command="{Binding Data.OpenHistoryEntryCommand, Source={StaticResource Proxy}}"
                                                                  CommandParameter="{Binding}"/>
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Grid.Row="1" Padding="8"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                                    <Button Content="Clear History" Style="{StaticResource DangerButton}"
                                            Command="{Binding ClearHistoryCommand}"
                                            HorizontalAlignment="Stretch" FontSize="11"/>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>

                <GridSplitter Grid.Column="1" Width="3"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}"/>

                <Grid Grid.Column="2">
                    <TabControl ItemsSource="{Binding Tabs}"
                                SelectedItem="{Binding SelectedTab}"
                                Background="Transparent">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                            </Style>
                        </TabControl.ItemContainerStyle>
                        <TabControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QueryTabViewModel}">
                                <StackPanel Orientation="Horizontal" MinWidth="110">
                                    <TextBlock Text="{Binding Title}"
                                               MaxWidth="180"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="•" Margin="4,0,0,0"
                                               Foreground="{DynamicResource AccentYellow}"
                                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"
                                               VerticalAlignment="Center"/>
                                    <Button Content="x"
                                            Style="{StaticResource GhostButton}"
                                            Padding="4,0"
                                            Margin="6,0,0,0"
                                            FontSize="11"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Close tab (Ctrl+W)"/>
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type vm:QueryTabViewModel}">
                                <views:QueryTabView/>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                    <Button Content="+"
                            Style="{StaticResource GhostButton}"
                            Width="28" Height="24"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,4,8,0"
                            Command="{Binding NewTabCommand}"
                            ToolTip="New tab (Ctrl+T)"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
